DATABASE_URL=postgresql://delivn_app:CHANGE_ME@127.0.0.1:5432/delivn_dev

# Development/E2E only. Demo tooling refuses production, non-loopback hosts,
# any database other than delivn_e2e, and refuses to run unless explicitly enabled.
DELIVN_E2E_DATABASE_URL=postgresql://delivn_app:CHANGE_ME@127.0.0.1:5432/delivn_e2e
DELIVN_ENABLE_DEMO_SEED=false

# Authentication. Generate a unique value containing at least 32 characters.
BETTER_AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
BETTER_AUTH_URL=http://127.0.0.1:3000

# Optional Google sign-in. Configure both or leave both blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
